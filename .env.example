DATABASE_URL=postgresql://parly:replace-with-password@localhost:5432/parly

RELAYER_PRIVATE_KEY=0xREPLACE_WITH_RELAYER_PRIVATE_KEY
RELAYER_BOX_PRIVATE_KEY_B64=
RELAYER_ADDRESS=0x0000000000000000000000000000000000000000
RELAYER_KEY_OUTPUT_FILE=.secrets/relayer-box.env

# Optional: set only if you want official registry listing and heartbeat updates.
RELAYER_REGISTRY_API_BASE_URL=https://parly.fi

RELAYER_PENDING_RECONCILE_INTERVAL_MS=30000

TEMPO_RPC_URL=https://rpc.tempo.xyz
TEMPO_CHAIN_ID=4217
SETTLEMENT_DOMAIN_ID=4217
PHASE3_ALLOWED_TOKEN_ADDRESSES=0x20c000000000000000000000b9537d11c60e8b50,0x20c00000000000000000000014f22ca97301eb73

WAKU_CLUSTER_ID=1
WAKU_BOOTSTRAP=true
WAKU_CONTENT_TOPIC=/parly/16.9.9/app/proto

# Live execution gates. Keep false unless you are ready to operate the corresponding live route.
PHASE3_FINALIZER_ENABLED=false
PHASE3_LIVE_TRANSACTIONS_ENABLED=false
PHASE3_RELAY_OUTBOUND_BROADCAST_ENABLED=false
PHASE3_PAYOUT_EXECUTION_ENABLED=false
PHASE3_FEE_PAYER_ENABLED=false
PHASE3_FUNDED_POC_ENABLED=false
CAMPAIGN_POOLV2_ATTRIBUTION_AWARDS_ENABLED=false
PHASE3_V3_PAYOUT_RUNTIME_ENABLED=false

# Optional relayer-owned one-time execution worker. Disabled by default.
PHASE3_RELAYER_OWNED_EXECUTION_WORKER_ENABLED=false
PHASE3_EXECUTION_DATABASE_URL=
PHASE3_EXECUTION_PAYLOAD_ENCRYPTION_KEY_B64=
PHASE3_RELAYER_OWNED_EXECUTION_WORKER_ID=
PHASE3_RELAYER_OWNED_EXECUTION_LEASE_MS=30000
PHASE3_RELAYER_OWNED_EXECUTION_POLL_MS=5000

# Current V4 receiving and private execution. Keep disabled until qualified.
PHASE3_RECEIVING_V4_PROFILE_JSON=
PHASE3_RECEIVING_V4_GAS_JSON=
PHASE3_RECEIVING_V4_FEE_TOKEN=
PHASE3_MIN_CONFIRMATIONS=
PARLY_SDK_ASSETS_PATH=
PHASE3_POOL_V4_RELAYER_ENABLED=false
PHASE3_POOL_V4_REWARD_GAS_UNITS=
PHASE3_POOL_V4_BATCH_REWARD_GAS_UNITS=
RELAY_REWARD_POLICY_V4_ADDRESS=
RELAY_REWARD_POLICY_V4_CODE_HASH=

# V7 uses pinned adapter, executor, provider target and attestation configuration.
PHASE3_PAYOUT_V7_RELAYER_WORKER_ENABLED=false
PHASE3_PAYOUT_V7_BROADCAST_ENABLED=false
PHASE3_PAYOUT_V7_CONFIG_JSON=
PHASE3_PAYOUT_V7_WEB_API_BASE_URL=
PHASE3_PAYOUT_V7_POLL_MS=5000
PHASE3_PAYOUT_V7_PROVENANCE_ATTESTER_URL=
PHASE3_PAYOUT_V7_PROOF_ATTESTER_URL=
PHASE3_PAYOUT_V7_PROOF_ATTESTER_B_URL=
PHASE3_PAYOUT_V7_PROOF_SIGNER_A=
PHASE3_PAYOUT_V7_PROOF_SIGNER_B=
PHASE3_PAYOUT_V7_ATTESTER_INTERNAL_TOKEN=
