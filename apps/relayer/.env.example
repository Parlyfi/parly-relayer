DATABASE_URL=postgresql://parly:replace-with-password@localhost:5432/parly

RELAYER_PRIVATE_KEY=0xREPLACE_WITH_RELAYER_PRIVATE_KEY
RELAYER_BOX_PRIVATE_KEY_B64=
RELAYER_ADDRESS=0x0000000000000000000000000000000000000000
RELAYER_KEY_OUTPUT_FILE=.secrets/relayer-box.env

RELAYER_REGISTRY_API_BASE_URL=http://localhost:3000
RELAYER_PENDING_RECONCILE_INTERVAL_MS=30000

TEMPO_RPC_URL=https://rpc.tempo.xyz
TEMPO_CHAIN_ID=4217
SETTLEMENT_DOMAIN_ID=4217

WAKU_CLUSTER_ID=1
WAKU_BOOTSTRAP=true
WAKU_CONTENT_TOPIC=/parly/16.9.9/app/proto

# Explicit Tempo mainnet relayer config surface.
# Do not reuse this staging file for mainnet. Mainnet must set PARLY_ENV=mainnet and pass
# `pnpm --filter @parly/relayer run smoke:mainnet-env` before any startup attempt.
# PARLY_ENV=mainnet
# LAUNCH_SCOPE=tempo-only
# USDC_ADDRESS=
# USDT_ADDRESS=
# USDC_POOL=
# USDT_POOL=
# PROTOCOL_TREASURY_ADDRESS=
# GROTH16_VERIFIER_ADDRESS=
# MAINNET_EXPECTED_TEMPO_CHAIN_ID=
# MAINNET_EXPECTED_SETTLEMENT_DOMAIN_ID=
# MAINNET_EXPECTED_USDC_ADDRESS=
# MAINNET_EXPECTED_USDT_ADDRESS=
# MAINNET_EXPECTED_USDC_POOL=
# MAINNET_EXPECTED_USDT_POOL=
# MAINNET_EXPECTED_PROTOCOL_TREASURY_ADDRESS=
# MAINNET_EXPECTED_GROTH16_VERIFIER_ADDRESS=

# Phase 3 finalizer scaffold. Disabled by default; do not place production secrets in this file.
PHASE3_FINALIZER_ENABLED=false
# PHASE3_USDC_POOL_V2=
# PHASE3_USDT_POOL_V2=
# PARLY_INGRESS_RECEIVER_ADDRESS=
# PARLY_VIRTUAL_DEPOSIT_MASTER_ADDRESS=
# PHASE3_ALLOWED_TOKEN_ADDRESSES=
